  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Allvisualtypesv3</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SELECTCOLUMNS(
		KEEPFILTERS(
			FILTER(
				KEEPFILTERS(
					SUMMARIZECOLUMNS(
						ROLLUPADDISSUBTOTAL(
							ROLLUPGROUP(
								'DimDate'[DateKey],
								'DimDate'[FullDateAlternateKey],
								'DimDate'[EnglishDayNameOfWeek],
								'DimDate'[SpanishDayNameOfWeek],
								'DimDate'[FrenchDayNameOfWeek],
								'DimDate'[EnglishMonthName],
								'DimDate'[SpanishMonthName],
								'DimDate'[FrenchMonthName],
								'DimGeography'[GeographyKey],
								'DimGeography'[City],
								'DimGeography'[StateProvinceCode],
								'DimGeography'[StateProvinceName],
								'DimGeography'[CountryRegionCode],
								'DimGeography'[EnglishCountryRegionName],
								'DimGeography'[SpanishCountryRegionName],
								'DimGeography'[FrenchCountryRegionName],
								'DimGeography'[PostalCode],
								'DimGeography'[SalesTerritoryKey],
								'DimGeography'[IpAddressLocator]
							), "IsGrandTotalRowTotal"
						),
						"SumDayNumberOfWeek", CALCULATE(SUM('DimDate'[DayNumberOfWeek])),
						"SumDayNumberOfMonth", CALCULATE(SUM('DimDate'[DayNumberOfMonth])),
						"SumDayNumberOfYear", CALCULATE(SUM('DimDate'[DayNumberOfYear])),
						"SumWeekNumberOfYear", CALCULATE(SUM('DimDate'[WeekNumberOfYear])),
						"SumMonthNumberOfYear", CALCULATE(SUM('DimDate'[MonthNumberOfYear])),
						"SumCalendarQuarter", CALCULATE(SUM('DimDate'[CalendarQuarter])),
						"SumCalendarYear", CALCULATE(SUM('DimDate'[CalendarYear])),
						"SumCalendarSemester", CALCULATE(SUM('DimDate'[CalendarSemester])),
						"SumFiscalQuarter", CALCULATE(SUM('DimDate'[FiscalQuarter])),
						"SumFiscalYear", CALCULATE(SUM('DimDate'[FiscalYear])),
						"SumFiscalSemester", CALCULATE(SUM('DimDate'[FiscalSemester])),
						"HasDataFactInternetSales", IGNORE(
							CALCULATE(NOT(ISEMPTY('FactInternetSales')))
						)
					)
				),
				[HasDataFactInternetSales]
			)
		),
		"'DimDate'[DateKey]", 'DimDate'[DateKey],
		"'DimDate'[FullDateAlternateKey]", 'DimDate'[FullDateAlternateKey],
		"'DimDate'[EnglishDayNameOfWeek]", 'DimDate'[EnglishDayNameOfWeek],
		"'DimDate'[SpanishDayNameOfWeek]", 'DimDate'[SpanishDayNameOfWeek],
		"'DimDate'[FrenchDayNameOfWeek]", 'DimDate'[FrenchDayNameOfWeek],
		"'DimDate'[EnglishMonthName]", 'DimDate'[EnglishMonthName],
		"'DimDate'[SpanishMonthName]", 'DimDate'[SpanishMonthName],
		"'DimDate'[FrenchMonthName]", 'DimDate'[FrenchMonthName],
		"'DimGeography'[GeographyKey]", 'DimGeography'[GeographyKey],
		"'DimGeography'[City]", 'DimGeography'[City],
		"'DimGeography'[StateProvinceCode]", 'DimGeography'[StateProvinceCode],
		"'DimGeography'[StateProvinceName]", 'DimGeography'[StateProvinceName],
		"'DimGeography'[CountryRegionCode]", 'DimGeography'[CountryRegionCode],
		"'DimGeography'[EnglishCountryRegionName]", 'DimGeography'[EnglishCountryRegionName],
		"'DimGeography'[SpanishCountryRegionName]", 'DimGeography'[SpanishCountryRegionName],
		"'DimGeography'[FrenchCountryRegionName]", 'DimGeography'[FrenchCountryRegionName],
		"'DimGeography'[PostalCode]", 'DimGeography'[PostalCode],
		"'DimGeography'[SalesTerritoryKey]", 'DimGeography'[SalesTerritoryKey],
		"'DimGeography'[IpAddressLocator]", 'DimGeography'[IpAddressLocator],
		"IsGrandTotalRowTotal", [IsGrandTotalRowTotal],
		"SumDayNumberOfWeek", [SumDayNumberOfWeek],
		"SumDayNumberOfMonth", [SumDayNumberOfMonth],
		"SumDayNumberOfYear", [SumDayNumberOfYear],
		"SumWeekNumberOfYear", [SumWeekNumberOfYear],
		"SumMonthNumberOfYear", [SumMonthNumberOfYear],
		"SumCalendarQuarter", [SumCalendarQuarter],
		"SumCalendarYear", [SumCalendarYear],
		"SumCalendarSemester", [SumCalendarSemester],
		"SumFiscalQuarter", [SumFiscalQuarter],
		"SumFiscalYear", [SumFiscalYear],
		"SumFiscalSemester", [SumFiscalSemester]
	)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'DimDate'[DateKey],
	'DimDate'[FullDateAlternateKey],
	'DimDate'[EnglishDayNameOfWeek],
	'DimDate'[SpanishDayNameOfWeek],
	'DimDate'[FrenchDayNameOfWeek],
	'DimDate'[EnglishMonthName],
	'DimDate'[SpanishMonthName],
	'DimDate'[FrenchMonthName],
	'DimGeography'[GeographyKey],
	'DimGeography'[City],
	'DimGeography'[StateProvinceCode],
	'DimGeography'[StateProvinceName],
	'DimGeography'[CountryRegionCode],
	'DimGeography'[EnglishCountryRegionName],
	'DimGeography'[SpanishCountryRegionName],
	'DimGeography'[FrenchCountryRegionName],
	'DimGeography'[PostalCode],
	'DimGeography'[SalesTerritoryKey],
	'DimGeography'[IpAddressLocator]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SELECTCOLUMNS(
			KEEPFILTERS(
				FILTER(
					KEEPFILTERS(
						SUMMARIZECOLUMNS(
							ROLLUPADDISSUBTOTAL(
								ROLLUPGROUP(
									'DimDate'[DateKey],
									'DimDate'[FullDateAlternateKey],
									'DimDate'[EnglishDayNameOfWeek],
									'DimDate'[SpanishDayNameOfWeek],
									'DimDate'[FrenchDayNameOfWeek],
