  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Allvisualtypesv3</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZECOLUMNS(
		ROLLUPADDISSUBTOTAL(
			ROLLUPGROUP(
				'DimDate'[DateKey],
				'DimDate'[FullDateAlternateKey],
				'DimDate'[EnglishDayNameOfWeek],
				'DimDate'[SpanishDayNameOfWeek],
				'DimDate'[FrenchDayNameOfWeek],
				'DimDate'[EnglishMonthName],
				'DimDate'[SpanishMonthName],
				'DimDate'[FrenchMonthName]
			), "IsGrandTotalRowTotal"
		),
		"SumDayNumberOfWeek", CALCULATE(SUM('DimDate'[DayNumberOfWeek])),
		"SumDayNumberOfMonth", CALCULATE(SUM('DimDate'[DayNumberOfMonth])),
		"SumDayNumberOfYear", CALCULATE(SUM('DimDate'[DayNumberOfYear])),
		"SumWeekNumberOfYear", CALCULATE(SUM('DimDate'[WeekNumberOfYear])),
		"SumMonthNumberOfYear", CALCULATE(SUM('DimDate'[MonthNumberOfYear])),
		"SumCalendarQuarter", CALCULATE(SUM('DimDate'[CalendarQuarter])),
		"SumCalendarYear", CALCULATE(SUM('DimDate'[CalendarYear])),
		"SumCalendarSemester", CALCULATE(SUM('DimDate'[CalendarSemester])),
		"SumFiscalQuarter", CALCULATE(SUM('DimDate'[FiscalQuarter])),
		"SumFiscalYear", CALCULATE(SUM('DimDate'[FiscalYear])),
		"SumFiscalSemester", CALCULATE(SUM('DimDate'[FiscalSemester]))
	)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'DimDate'[DateKey],
	'DimDate'[FullDateAlternateKey],
	'DimDate'[EnglishDayNameOfWeek],
	'DimDate'[SpanishDayNameOfWeek],
	'DimDate'[FrenchDayNameOfWeek],
	'DimDate'[EnglishMonthName],
	'DimDate'[SpanishMonthName],
	'DimDate'[FrenchMonthName]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP(
					'DimDate'[DateKey],
					'DimDate'[FullDateAlternateKey],
					'DimDate'[EnglishDayNameOfWeek],
					'DimDate'[SpanishDayNameOfWeek],
					'DimDate'[FrenchDayNameOfWeek],
					'DimDate'[EnglishMonthName],
					'DimDate'[SpanishMonthName],
					'DimDate'[FrenchMonthName]
				), "IsGrandTotalRowTotal"
			),
			"SumDayNumberOfWeek", CALCULATE(SUM('DimDate'[DayNumberOfWeek])),
			"SumDayNumberOfMonth", CALCULATE(SUM('DimDate'[DayNumberOfMonth])),
			"SumDayNumberOfYear", CALCULATE(SUM('DimDate'[DayNumberOfYear])),
			"SumWeekNumberOfYear", CALCULATE(SUM('DimDate'[WeekNumberOfYear])),
			"SumMonthNumberOfYear", CALCULATE(SUM('DimDate'[MonthNumberOfYear])),
			"SumCalendarQuarter", CALCULATE(SUM('DimDate'[CalendarQuarter])),
			"SumCalendarYear", CALCULATE(SUM('DimDate'[CalendarYear])),
			"SumCalendarSemester", CALCULATE(SUM('DimDate'[CalendarSemester])),
			"SumFiscalQuarter", CALCULATE(SUM('DimDate'[FiscalQuarter])),
			"SumFiscalYear", CALCULATE(SUM('DimDate'[FiscalYear])),
			"SumFiscalSemester", CALCULATE(SUM('DimDate'[FiscalSemester]))
		)

	VAR __DS0BodyLimited = 
		TOPN(
			500,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'DimDate'[DateKey],
			1,
			'DimDate'[FullDateAlternateKey],
			1,
			'DimDate'[EnglishDayNameOfWeek],
			1,
			'DimDate'[SpanishDayNameOfWeek],
			1,
			'DimDate'[FrenchDayNameOfWeek],
			1,
			'DimDate'[EnglishMonthName],
			1,
			'DimDate'[SpanishMonthName],
			1,
			'DimDate'[FrenchMonthName],
			1
		)

EVALUATE
	__DS0BodyLimited

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'DimDate'[DateKey],
	'DimDate'[FullDateAlternateKey],
	'DimDate'[EnglishDayNameOfWeek],
	'DimDate'[SpanishDayNameOfWeek],
	'DimDate'[FrenchDayNameOfWeek],
	'DimDate'[EnglishMonthName],
	'DimDate'[SpanishMonthName],
	'DimDate'[FrenchMonthName]</wa:PreviewCommandText>
      </Query>
