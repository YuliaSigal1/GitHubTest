  <DataSources>
    <DataSource Name="FamilyBM2Mv3_1Copy3">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://dailyapi.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-d8ca42c8-eb6a-43e2-8687-8fe9dced93d7;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
