				    [$Table].[NumberEmployees] as [NumberEmployees],
				    [$Table].[OrderFrequency] as [OrderFrequency],
				    [$Table].[OrderMonth] as [OrderMonth],
				    [$Table].[FirstOrderYear] as [FirstOrderYear],
				    [$Table].[LastOrderYear] as [LastOrderYear],
				    [$Table].[ProductLine] as [ProductLine],
				    [$Table].[AddressLine1] as [AddressLine1],
				    [$Table].[AddressLine2] as [AddressLine2],
				    [$Table].[AnnualSales] as [AnnualSales],
				    [$Table].[BankName] as [BankName],
				    [$Table].[MinPaymentType] as [MinPaymentType],
				    [$Table].[MinPaymentAmount] as [MinPaymentAmount],
				    [$Table].[AnnualRevenue] as [AnnualRevenue],
				    [$Table].[YearOpened] as [YearOpened]
				from [dbo].[DimReseller] as [$Table]
			dataSource: 7701998d-889b-4b70-a620-cbf5d0d6c4c9

