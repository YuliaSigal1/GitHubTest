  <DataSources>
    <DataSource Name="FamilyBM2Mv3">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://dailyapi.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-ce196484-ba68-4c7f-ad42-5a541fb647f5;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>FamilyBM2Mv3</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZECOLUMNS(
		ROLLUPADDISSUBTOTAL(
			ROLLUPGROUP('family'[Name], 'members'[Name], 'members'[Family]), "IsGrandTotalRowTotal"
		),
		"CountId", CALCULATE(COUNTA('family'[Id])),
		"membersCountId", CALCULATE(COUNTA('members'[Id]))
	)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'family'[Name], 'members'[Name], 'members'[Family]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP('family'[Name], 'members'[Name], 'members'[Family]), "IsGrandTotalRowTotal"
			),
			"CountId", CALCULATE(COUNTA('family'[Id])),
			"membersCountId", CALCULATE(COUNTA('members'[Id]))
		)

	VAR __DS0BodyLimited = 
		TOPN(
			500,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'family'[Name],
			1,
			'members'[Name],
			1,
			'members'[Family],
			1
		)

EVALUATE
	__DS0BodyLimited

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'family'[Name], 'members'[Name], 'members'[Family]</wa:PreviewCommandText>
      </Query>
      <Fields>
        <Field Name="family_Id">
          <DataField>[CountId]</DataField>
        </Field>
        <Field Name="family_Name">
          <DataField>family[Name]</DataField>
          <AggregateIndicatorField xmlns="http://schemas.microsoft.com/sqlserver/reporting/2011/01/reportdefinition">x_5b_IsGrandTotalRowTotal_5d_</AggregateIndicatorField>
        </Field>
        <Field Name="members_Id">
          <DataField>[membersCountId]</DataField>
        </Field>
        <Field Name="members_Name">
          <DataField>members[Name]</DataField>
          <AggregateIndicatorField xmlns="http://schemas.microsoft.com/sqlserver/reporting/2011/01/reportdefinition">x_5b_IsGrandTotalRowTotal_5d_</AggregateIndicatorField>
        </Field>
        <Field Name="members_Family">
          <DataField>members[Family]</DataField>
          <AggregateIndicatorField xmlns="http://schemas.microsoft.com/sqlserver/reporting/2011/01/reportdefinition">x_5b_IsGrandTotalRowTotal_5d_</AggregateIndicatorField>
        </Field>
        <Field Name="x_5b_IsGrandTotalRowTotal_5d_">
          <DataField>[IsGrandTotalRowTotal]</DataField>
        </Field>
      </Fields>
      <InterpretSubtotalsAsDetails>False</InterpretSubtotalsAsDetails>
    </DataSet>
  </DataSets>
