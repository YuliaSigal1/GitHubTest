  <DataSources>
    <DataSource Name="Allvisualtypesv3test">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://dailyapi.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-79e066f5-15c3-4347-b624-8f9a79d442ad;Integrated Security=ClaimsToken</ConnectString>
