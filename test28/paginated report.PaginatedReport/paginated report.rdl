							"HasDataFactInternetSales", IGNORE(
								CALCULATE(NOT(ISEMPTY('FactInternetSales')))
							)
						)
					),
					[HasDataFactInternetSales]
				)
			),
			"'DimDate'[DateKey]", 'DimDate'[DateKey],
