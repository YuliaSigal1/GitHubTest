  <DataSources>
    <DataSource Name="Allvisualtypesv3">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://dailyapi.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-4ec632a6-4d13-4a93-9168-e93f966c33f2;Integrated Security=ClaimsToken</ConnectString>
