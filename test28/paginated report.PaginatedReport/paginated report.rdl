  <DataSources>
    <DataSource Name="Allvisualtypesv3">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://dailyapi.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-c74f666d-cf6a-4cb7-b3ac-e8ca38d335e2;Integrated Security=ClaimsToken</ConnectString>
