  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Allvisualtypesv3">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://dailyapi.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-5733f043-1f72-44f7-908c-fe37b08977ac;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
