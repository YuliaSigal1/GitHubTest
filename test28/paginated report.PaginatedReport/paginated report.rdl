			"'DimDate'[EnglishDayNameOfWeek]", 'DimDate'[EnglishDayNameOfWeek],
			"'DimDate'[SpanishDayNameOfWeek]", 'DimDate'[SpanishDayNameOfWeek],
			"'DimDate'[FrenchDayNameOfWeek]", 'DimDate'[FrenchDayNameOfWeek],
			"'DimDate'[EnglishMonthName]", 'DimDate'[EnglishMonthName],
			"'DimDate'[SpanishMonthName]", 'DimDate'[SpanishMonthName],
			"'DimDate'[FrenchMonthName]", 'DimDate'[FrenchMonthName],
			"'DimGeography'[GeographyKey]", 'DimGeography'[GeographyKey],
			"'DimGeography'[City]", 'DimGeography'[City],
			"'DimGeography'[StateProvinceCode]", 'DimGeography'[StateProvinceCode],
			"'DimGeography'[StateProvinceName]", 'DimGeography'[StateProvinceName],
			"'DimGeography'[CountryRegionCode]", 'DimGeography'[CountryRegionCode],
			"'DimGeography'[EnglishCountryRegionName]", 'DimGeography'[EnglishCountryRegionName],
			"'DimGeography'[SpanishCountryRegionName]", 'DimGeography'[SpanishCountryRegionName],
			"'DimGeography'[FrenchCountryRegionName]", 'DimGeography'[FrenchCountryRegionName],
			"'DimGeography'[PostalCode]", 'DimGeography'[PostalCode],
			"'DimGeography'[SalesTerritoryKey]", 'DimGeography'[SalesTerritoryKey],
			"'DimGeography'[IpAddressLocator]", 'DimGeography'[IpAddressLocator],
			"IsGrandTotalRowTotal", [IsGrandTotalRowTotal],
			"SumDayNumberOfWeek", [SumDayNumberOfWeek],
			"SumDayNumberOfMonth", [SumDayNumberOfMonth],
			"SumDayNumberOfYear", [SumDayNumberOfYear],
			"SumWeekNumberOfYear", [SumWeekNumberOfYear],
			"SumMonthNumberOfYear", [SumMonthNumberOfYear],
			"SumCalendarQuarter", [SumCalendarQuarter],
			"SumCalendarYear", [SumCalendarYear],
			"SumCalendarSemester", [SumCalendarSemester],
			"SumFiscalQuarter", [SumFiscalQuarter],
			"SumFiscalYear", [SumFiscalYear],
			"SumFiscalSemester", [SumFiscalSemester]
		)

	VAR __DS0BodyLimited = 
		TOPN(
			500,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'DimDate'[DateKey],
			1,
			'DimDate'[FullDateAlternateKey],
			1,
			'DimDate'[EnglishDayNameOfWeek],
			1,
