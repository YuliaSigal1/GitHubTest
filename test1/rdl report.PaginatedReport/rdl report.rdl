  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Allvisualtypesv3</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZECOLUMNS(
		ROLLUPADDISSUBTOTAL(
			ROLLUPGROUP(
				'DimCustomer'[CustomerKey],
				'DimCustomer'[GeographyKey],
				'DimCustomer'[CustomerAlternateKey],
				'DimCustomer'[Title],
				'DimCustomer'[FirstName],
				'DimCustomer'[MiddleName],
				'DimCustomer'[LastName],
				'DimCustomer'[NameStyle],
				'DimCustomer'[BirthDate],
				'DimCustomer'[MaritalStatus],
				'DimCustomer'[Suffix],
				'DimCustomer'[Gender],
				'DimCustomer'[EmailAddress],
				'DimCustomer'[EnglishEducation],
				'DimCustomer'[SpanishEducation],
				'DimCustomer'[FrenchEducation],
				'DimCustomer'[EnglishOccupation],
				'DimCustomer'[SpanishOccupation],
				'DimCustomer'[FrenchOccupation],
				'DimCustomer'[HouseOwnerFlag],
				'DimCustomer'[AddressLine1],
				'DimCustomer'[AddressLine2],
				'DimCustomer'[Phone],
				'DimCustomer'[DateFirstPurchase],
				'DimCustomer'[CommuteDistance]
			), "IsGrandTotalRowTotal"
		),
		"SumYearlyIncome", CALCULATE(SUM('DimCustomer'[YearlyIncome])),
		"SumTotalChildren", CALCULATE(SUM('DimCustomer'[TotalChildren])),
		"SumNumberChildrenAtHome", CALCULATE(SUM('DimCustomer'[NumberChildrenAtHome])),
		"SumNumberCarsOwned", CALCULATE(SUM('DimCustomer'[NumberCarsOwned]))
	)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'DimCustomer'[CustomerKey],
	'DimCustomer'[GeographyKey],
	'DimCustomer'[CustomerAlternateKey],
	'DimCustomer'[Title],
	'DimCustomer'[FirstName],
	'DimCustomer'[MiddleName],
	'DimCustomer'[LastName],
	'DimCustomer'[NameStyle],
	'DimCustomer'[BirthDate],
	'DimCustomer'[MaritalStatus],
	'DimCustomer'[Suffix],
	'DimCustomer'[Gender],
	'DimCustomer'[EmailAddress],
	'DimCustomer'[EnglishEducation],
	'DimCustomer'[SpanishEducation],
	'DimCustomer'[FrenchEducation],
	'DimCustomer'[EnglishOccupation],
	'DimCustomer'[SpanishOccupation],
	'DimCustomer'[FrenchOccupation],
	'DimCustomer'[HouseOwnerFlag],
	'DimCustomer'[AddressLine1],
	'DimCustomer'[AddressLine2],
	'DimCustomer'[Phone],
	'DimCustomer'[DateFirstPurchase],
	'DimCustomer'[CommuteDistance]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP(
					'DimCustomer'[CustomerKey],
					'DimCustomer'[GeographyKey],
					'DimCustomer'[CustomerAlternateKey],
					'DimCustomer'[Title],
					'DimCustomer'[FirstName],
					'DimCustomer'[MiddleName],
					'DimCustomer'[LastName],
					'DimCustomer'[NameStyle],
